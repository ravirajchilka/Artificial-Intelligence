// build and execute in single command for VScode saveAndRun extension
"saveAndRun": {
    "commands": [
        {
            "match": ".cpp",
             "cmd": "cd E:/Software_Projects/RL_DRL_practice; Remove-Item -Recurse -Force build; mkdir build; cd build; cmake -G \"Visual Studio 17 2022\" -A x64 ..; cmake --build . --config Release; cd Release; ./MyApp.exe"
                    ,
            "useShortcut": false,
            "silent": false
        }
    ]
}
